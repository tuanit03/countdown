[Unit]
Description=Countdown — frameless focus timer (Docker)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=@DIR@
ExecStartPre=/bin/mkdir -p %t/countdown %h/.local/share/backgrounds
ExecStart=/usr/bin/docker compose up --no-build --no-log-prefix countdown
ExecStop=/usr/bin/docker compose stop countdown
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
