#!/bin/sh
# Start the Countdown container for the current desktop session.
# Run at login by XDG autostart (~/.config/autostart/countdown.desktop) and on demand by countdown-toggle.
image="${COUNTDOWN_IMAGE:-@IMAGE@}"
rt="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
# Docker would create a missing bind-mount source owned by root; make it ours first.
mkdir -p "$rt/countdown"

set -- -d --name countdown --init --restart on-failure:3 \
	--network none --read-only --cap-drop ALL --security-opt no-new-privileges \
	--memory 96m --cpus 0.5 \
	--tmpfs /tmp --tmpfs /home/countdown/.cache:mode=1777 \
	-u "$(id -u):$(id -g)" \
	-e DISPLAY="${DISPLAY:-:0}" -v /tmp/.X11-unix:/tmp/.X11-unix:ro \
	-v "$rt/countdown":/run/countdown -v countdown-data:/data

# Optional pieces: each one only if this desktop has it.
xauth="${XAUTHORITY:-$HOME/.Xauthority}"
[ -f "$xauth" ] && set -- "$@" -e XAUTHORITY=/tmp/.Xauthority -v "$xauth":/tmp/.Xauthority:ro
[ -S "$rt/pulse/native" ] && set -- "$@" -e PULSE_SERVER=unix:/run/pulse/native -v "$rt/pulse/native":/run/pulse/native
[ -d "$HOME/.config/dconf" ] && set -- "$@" -v "$HOME/.config/dconf":/home/countdown/.config/dconf:ro
for d in /usr/share/backgrounds "$HOME/.local/share/backgrounds"; do
	[ -d "$d" ] && set -- "$@" -v "$d":"$d":ro
done

docker rm -f countdown >/dev/null 2>&1 || true
exec docker run "$@" "$image" >/dev/null
